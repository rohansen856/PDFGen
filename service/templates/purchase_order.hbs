<!doctype html><html><head><meta charset="utf-8">{{> styles}}</head><body>
{{#if isFirst}}
  <h1>PURCHASE ORDER</h1>
  <div class="meta">
    <span class="muted">PO No.</span><b>{{d.po_number}}</b>
    <span class="muted">PO Date</span><span>{{d.po_date}}</span>
    <span class="muted">Delivery by</span><span>{{d.delivery_date}}</span>
    <span class="muted">Currency</span><span>{{d.currency}}</span>
  </div>
  <div class="parties">
    <div class="party"><span class="muted">Buyer</span><b>{{d.company.name}}</b>{{d.company.address}}<br>GSTIN: {{d.company.gstin}}</div>
    <div class="party"><span class="muted">Vendor</span><b>{{d.vendor.name}}</b>{{d.vendor.address}}<br>GSTIN: {{d.vendor.gstin}}</div>
  </div>
{{else}}
  <p class="continued">{{d.po_number}} — line items continued (from item {{firstLineNo}})</p>
{{/if}}
<table class="lines">
  <thead><tr><th>#</th><th>SKU</th><th>Description</th><th>HSN</th><th class="num">Qty</th><th>Unit</th><th class="num">Rate</th><th class="num">GST %</th><th class="num">Amount</th></tr></thead>
  <tbody>
  {{#each rows}}
    <tr><td>{{lineNo}}</td><td>{{sku}}</td><td>{{description}}</td><td>{{hsn}}</td><td class="num">{{qty}}</td><td>{{unit}}</td><td class="num">{{money rate}}</td><td class="num">{{tax_rate}}</td><td class="num">{{money amount}}</td></tr>
  {{/each}}
  </tbody>
</table>
{{#if isLast}}
  <table class="totals">
    <tr><td>Sub-total</td><td class="num">{{money d.totals.subtotal}}</td></tr>
    <tr><td>GST</td><td class="num">{{money d.totals.tax}}</td></tr>
    <tr class="grand"><td>Total</td><td class="num">{{money d.totals.grand_total}}</td></tr>
  </table>
  {{#if d.notes}}<div class="notes"><b>Notes</b><br>{{d.notes}}</div>{{/if}}
{{/if}}
</body></html>
